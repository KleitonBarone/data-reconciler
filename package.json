{
  "name": "data-reconciler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dry-run reconciliation for two local commerce systems.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "data-reconciler": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "examples",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "benchmark": "tsx tests/benchmark.ts",
    "example:worker": "tsx src/examples/worker.ts",
    "example:http": "tsx src/examples/http.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "reconcile": "tsx src/cli.ts reconcile",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "pnpm build && vitest run tests/e2e",
    "test:watch": "vitest --exclude tests/e2e/**",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.23.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
